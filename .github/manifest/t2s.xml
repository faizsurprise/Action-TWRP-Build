<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!-- Recovery-only overlay for upstream twrp-12.1 manifest commit
         6dc117d9cbd08430daa16db2013560e1c4017fa8.
         The workflow verifies that base revision and the effective checkout.
         Undefined modules outside the recoveryimage graph are tolerated
         during Soong parsing; selected recovery dependencies must still build. -->

    <!-- 1. Exact device, TWRP and Vold source pins. -->
    <remote name="xfwdrev" fetch="https://github.com/xfwdrev" />
    <project name="android_device_samsung_exynos2100"
             path="device/samsung/exynos2100"
             remote="xfwdrev"
             revision="0d8b294de8ec86963576ea4710f64207824134c4"
             clone-depth="1" />
    <extend-project name="android_bootable_recovery"
                    path="bootable/recovery"
                    revision="5c3d206a5eeb3d446bcda8248a405a4b278bab5c" />
    <extend-project name="android_system_vold"
                    path="system/vold"
                    revision="a164ba05c5fef288059774a776b2e6e1119957cf" />

    <!-- 2. Genuine production providers needed by retained frameworks.
         The upstream minimal removals omit system/media and external/speex,
         even though frameworks/av depends on libaudioutils, which in turn
         depends on libspeexresampler. Do not use stub modules here. -->
    <project name="platform/system/media"
             path="system/media"
             remote="aosp"
             revision="refs/tags/android-12.1.0_r4"
             groups="default"
             clone-depth="1" />
    <project name="platform/external/speex"
             path="external/speex"
             remote="aosp"
             revision="refs/tags/android-12.1.0_r4"
             groups="default"
             clone-depth="1" />

    <!-- 3. Original Android 12.1 Soong defaults/providers for the retained
         source tree. These preserve known definitions without fabricating
         dependencies; isolated host-only tests are excluded at build prep. -->
    <project name="platform/test/vts-testcase/fuzz"
             path="test/vts-testcase/fuzz"
             remote="aosp"
             revision="refs/tags/android-12.1.0_r4"
             groups="default"
             clone-depth="1" />
    <project name="platform/packages/modules/NeuralNetworks"
             path="packages/modules/NeuralNetworks"
             remote="aosp"
             revision="refs/tags/android-12.1.0_r4"
             groups="default"
             clone-depth="1" />
    <project name="platform/packages/modules/NetworkStack"
             path="packages/modules/NetworkStack"
             remote="aosp"
             revision="refs/tags/android-12.1.0_r4"
             groups="default"
             clone-depth="1" />
    <project name="platform/external/hamcrest"
             path="external/hamcrest"
             remote="aosp"
             revision="refs/tags/android-12.1.0_r4"
             groups="default"
             clone-depth="1" />
    <project name="platform/external/junit"
             path="external/junit"
             remote="aosp"
             revision="refs/tags/android-12.1.0_r4"
             groups="default"
             clone-depth="1" />

    <!-- 4. Remove entire test-only projects. The retained
         test/vts-testcase/fuzz project above supplies Soong defaults;
         the VTS host harnesses and Java gRPC test tooling are unnecessary. -->
    <remove-project name="platform/external/grpc-grpc-java" />
    <remove-project name="platform/test/vts" />
    <remove-project name="platform/test/vts-testcase/hal" />
</manifest>
