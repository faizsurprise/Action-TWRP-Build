diff --git a/t2s/BoardConfig.mk b/t2s/BoardConfig.mk
index a6599c4..bea588e 100644
--- a/t2s/BoardConfig.mk
+++ b/t2s/BoardConfig.mk
@@ -19,11 +19,29 @@ BOARD_GROUP_BASIC_SIZE := 11425284096
 BOARD_GROUP_BASIC_PARTITION_LIST := system odm product vendor
 
 BOARD_PARTITION_LIST := $(call to-upper, $(BOARD_GROUP_BASIC_PARTITION_LIST))
-$(foreach p, $(BOARD_PARTITION_LIST), $(eval BOARD_$(p)IMAGE_FILE_SYSTEM_TYPE := f2fs))
+$(foreach p, $(BOARD_PARTITION_LIST), $(eval BOARD_$(p)IMAGE_FILE_SYSTEM_TYPE := ext4))
 $(foreach p, $(BOARD_PARTITION_LIST), $(eval TARGET_COPY_OUT_$(p) := $(call to-lower, $(p))))
 
 # Display
 TW_MAX_BRIGHTNESS := 561
 TW_DEFAULT_BRIGHTNESS := 255
 
-include $(DEVICE_PATH)/BoardConfig.mk
\ No newline at end of file
+include $(DEVICE_PATH)/BoardConfig.mk
+
+BOARD_KERNEL_CMDLINE := $(filter-out androidboot.selinux=permissive,$(BOARD_KERNEL_CMDLINE))
+BOARD_MKBOOTIMG_ARGS := $(subst --os_version 14.0.0,--os_version 11.0.0,$(BOARD_MKBOOTIMG_ARGS))
+
+TW_INCLUDE_CRYPTO := true
+TW_USES_VENDOR_LIBS := true
+TW_USE_EXYNOS2100_CRYPTO_SERVICES := true
+
+# Match the DTB load address and kernel base in the JHZA6 recovery header.
+BOARD_KERNEL_BASE := 0x80000000
+BOARD_MKBOOTIMG_ARGS := $(subst --dtb_offset 0x100000000,--dtb_offset 0x0,$(BOARD_MKBOOTIMG_ARGS))
+TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/t2s/recovery.fstab
+
+# Kernel .ko files are ELF relocatable modules copied verbatim from the
+# SHA-256-verified JHZA6 recovery ramdisk, not user-space ELF prebuilts.
+# Android's generic PRODUCT_COPY_FILES ELF gate rejects them; permit this
+# recovery-only copy while retaining the exact firmware-content checks.
+BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true
