diff --git a/t2s/recovery.fstab b/t2s/recovery.fstab
new file mode 100644
index 0000000..8f50d6d
--- /dev/null
+++ b/t2s/recovery.fstab
@@ -0,0 +1,13 @@
+# Android fstab file.
+#<src>                  <mnt_point>         <type>    <mnt_flags and options>                               <fs_mgr_flags>
+# The filesystem that contains the filesystem checker binary (typically /system) cannot
+# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
+
+system					/system		ext4	ro			wait,logical,first_stage_mount
+vendor					/vendor		ext4	ro			wait,logical,first_stage_mount
+product					/product	ext4	ro			wait,logical,first_stage_mount
+odm					    /odm		  ext4	ro			wait,logical,first_stage_mount
+
+/dev/block/by-name/metadata	/metadata	ext4	noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic,sync	wait,formattable,first_stage_mount,check
+/dev/block/by-name/userdata	/data	f2fs	noatime,nosuid,nodev,discard,usrquota,grpquota,fsync_mode=nobarrier,reserve_root=32768,resgid=5678,inlinecrypt	latemount,wait,check,fileencryption=aes-256-xts:aes-256-cts:v2,quota,reservedsize=128M,checkpoint=fs,fscompress,length=-20480,keydirectory=/metadata/vold/metadata_encryption
+/dev/block/by-name/misc /misc               emmc    defaults        defaults,first_stage_mount
diff --git a/t2s/recovery/init.exynos2100.crypto.rc b/t2s/recovery/init.exynos2100.crypto.rc
new file mode 100644
index 0000000..46aaf4a
--- /dev/null
+++ b/t2s/recovery/init.exynos2100.crypto.rc
@@ -0,0 +1,42 @@
+on property:twrp.exynos2100.crypto.start=1
+    mkdir /mnt/vendor 0755 root root
+    mkdir /mnt/vendor/efs 0755 root root
+    mount ext4 /dev/block/by-name/efs /mnt/vendor/efs ro nosuid nodev noexec noload
+    mkdir /dev/socket/iwt 0770 system system
+    mkdir /dev/socket/iwt/ca 0770 system system
+    start recovery_tzdaemon
+
+on property:twrp.exynos2100.crypto.start=1 && property:vendor.tzdaemon=Ready
+    setprop vendor.TEEGRIS.loaded true
+    write /proc/iccc_ready 1
+    start recovery_tzts_daemon
+
+on property:twrp.exynos2100.crypto.start=1 && property:vendor.tzts_daemon=Ready
+    start recovery_keymaster
+    start recovery_gatekeeper
+
+service recovery_tzdaemon /vendor/bin/tzdaemon
+    user system
+    group system readproc
+    seclabel u:r:recovery:s0
+    disabled
+
+service recovery_tzts_daemon /vendor/bin/tzts_daemon
+    user system
+    group system
+    seclabel u:r:recovery:s0
+    disabled
+
+service recovery_keymaster /vendor/bin/hw/android.hardware.keymaster@4.0-service
+    interface android.hardware.keymaster@4.0::IKeymasterDevice default
+    user system
+    group system drmrpc
+    seclabel u:r:recovery:s0
+    disabled
+
+service recovery_gatekeeper /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
+    interface android.hardware.gatekeeper@1.0::IGatekeeper default
+    user system
+    group system 5678
+    seclabel u:r:recovery:s0
+    disabled
